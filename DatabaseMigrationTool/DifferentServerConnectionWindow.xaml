<syncfusion:ChromelessWindow x:Class="DatabaseMigrationTool.DifferentServerConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=VisualStudio2015}"
        mc:Ignorable="d"
        Title="Connect to Different Server" 
        Height="700" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MinHeight="600" MinWidth="500"
        Icon="app-icon.png">

    <syncfusion:ChromelessWindow.Resources>
        <!-- Icon Templates -->

        <!-- Server Icon -->
        <DataTemplate x:Key="ServerIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM20 3H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" 
                        Fill="#569CD6"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Test Connection Icon -->
        <DataTemplate x:Key="TestConnectionIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M12 2C6.48 2 2 6.48 2 12c0 5.52 4.48 10 10 10s10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" 
                        Fill="#4EC9B0"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Load Databases Icon -->
        <DataTemplate x:Key="ConnectDbIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M12 3c-4.97 0-9 4.03-9 9H0l4 4 4-4H5c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C6.99 19.71 9.35 21 12 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.25 2.52.77-1.28-3.52-2.09V8H11z" 
                        Fill="#569CD6"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Fullscreen Icon -->
        <DataTemplate x:Key="FullscreenIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" 
                        Fill="White"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Check Icon -->
        <DataTemplate x:Key="CheckIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" 
                        Fill="#4EC9B0"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Cancel Icon -->
        <DataTemplate x:Key="CancelIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z" 
                        Fill="#F44336"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

    </syncfusion:ChromelessWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="20,15">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ContentControl ContentTemplate="{StaticResource ServerIcon}" 
                                  Width="24" Height="24" 
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                    <TextBlock Text="Connect to Different Server" 
                              FontSize="20" FontWeight="SemiBold" 
                              Foreground="#F1F1F1"
                              VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Enter connection details for the target server" 
                          FontSize="12" 
                          Foreground="#999999"
                          HorizontalAlignment="Center" 
                          Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Connection Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,20">
            <StackPanel>
                <!-- Server Connection -->
                <GroupBox Header="🌐 Server Connection" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <Label Content="Server Name" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox Name="cmbTargetServer" IsEditable="True" 
                                SelectionChanged="TargetServer_SelectionChanged" Height="30"/>

                        <CheckBox Name="chkTargetWindowsAuth" Content="Use Windows Authentication" 
                                IsChecked="True" Margin="0,15,0,0"
                                Checked="TargetWindowsAuth_Changed" Unchecked="TargetWindowsAuth_Changed"/>

                        <StackPanel Name="targetSqlAuthPanel" Visibility="Collapsed" Margin="0,15,0,0">
                            <Label Content="Username" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Name="txtTargetUsername" Height="30"/>
                            <Label Content="Password" FontWeight="SemiBold" Margin="0,10,0,5"/>
                            <PasswordBox Name="txtTargetPassword" Height="30"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <syncfusion:ButtonAdv Name="btnTestConnection" 
                                                Label="Test Connection"
                                                IconTemplate="{StaticResource TestConnectionIcon}"
                                                SizeMode="Normal" 
                                                Click="TestConnection_Click"
                                                Margin="0,0,10,0" 
                                                Width="150" 
                                                Height="32"/>
                            <syncfusion:ButtonAdv Name="btnLoadDatabases" 
                                                Label="Load Databases"
                                                IconTemplate="{StaticResource ConnectDbIcon}"
                                                SizeMode="Normal" 
                                                Click="LoadDatabases_Click"
                                                Width="150" 
                                                Height="32"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Available Databases -->
                <GroupBox Header="📂 Available Databases" Padding="15">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Select target databases" 
                                     FontSize="12" Foreground="#808080" VerticalAlignment="Center"/>
                            <syncfusion:ButtonAdv Grid.Column="1" 
                                                Name="btnFullscreenDatabases" 
                                                Label=""
                                                IconTemplate="{StaticResource FullscreenIcon}"
                                                ToolTip="Open fullscreen database selector"
                                                Click="FullscreenDatabases_Click"
                                                Width="32" 
                                                Height="32" 
                                                SizeMode="Small"/>
                        </Grid>

                        <ListBox Name="lstTargetDatabases" Height="200" Margin="0,0,0,10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" 
                                                FontSize="11"
                                                VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Background="#3E3E42" CornerRadius="4" Padding="10">
                            <TextBlock Name="txtSelectedDatabasesCount" 
                                     Text="0 database(s) selected" 
                                     FontSize="11" 
                                     Foreground="#F1F1F1"
                                     HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="0,1,0,0" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <syncfusion:ButtonAdv Name="btnConnect" 
                                    Label="Connect and Use"
                                    IconTemplate="{StaticResource CheckIcon}"
                                    SizeMode="Normal" 
                                    Click="Connect_Click"
                                    IsEnabled="False"
                                    Margin="0,0,15,0" 
                                    Width="170" 
                                    Height="36"/>
                <syncfusion:ButtonAdv Name="btnCancel" 
                                    Label="Cancel"
                                    IconTemplate="{StaticResource CancelIcon}"
                                    SizeMode="Normal" 
                                    Click="Cancel_Click" 
                                    Width="120" 
                                    Height="36"/>
            </StackPanel>
        </Border>
    </Grid>
</syncfusion:ChromelessWindow>
