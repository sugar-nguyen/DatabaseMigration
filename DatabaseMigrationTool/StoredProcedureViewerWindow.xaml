<syncfusion:ChromelessWindow x:Class="DatabaseMigrationTool.StoredProcedureViewerWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=VisualStudio2015}"
        Title="Stored Procedure Viewer" 
        Height="700" 
        Width="1000"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        MinHeight="500"
        MinWidth="800"
        Icon="app-icon.png">
    <syncfusion:ChromelessWindow.Resources>
        <!-- Icon Templates -->

        <!-- Copy Icon -->
        <DataTemplate x:Key="CopyIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" 
                          Fill="#4EC9B0"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Close/Check Icon -->
        <DataTemplate x:Key="CheckIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" 
                          Fill="#4EC9B0"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Script/Document Icon -->
        <DataTemplate x:Key="DocumentIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" 
                          Fill="White"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Database Icon -->
        <DataTemplate x:Key="DatabaseIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M12 1C6.48 1 2 2.79 2 5v14c0 2.21 4.48 4 10 4s10-1.79 10-4V5c0-2.21-4.48-4-10-4zm0 2c4.42 0 8 1.34 8 3s-3.58 3-8 3-8-1.34-8-3 3.58-3 8-3zM4 9.5c1.72 1.05 4.56 1.5 8 1.5s6.28-.45 8-1.5V12c0 1.66-3.58 3-8 3s-8-1.34-8-3V9.5zm0 5c1.72 1.05 4.56 1.5 8 1.5s6.28-.45 8-1.5V17c0 1.66-3.58 3-8 3s-8-1.34-8-3v-2.5z" 
                          Fill="#4EC9B0"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Export Icon -->
        <DataTemplate x:Key="ExportIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2z" 
                          Fill="White"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Save Icon -->
        <DataTemplate x:Key="SaveIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" 
                          Fill="White"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Refresh Icon -->
        <DataTemplate x:Key="RefreshIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" 
                          Fill="#569CD6"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Search Icon -->
        <DataTemplate x:Key="SearchIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                          Fill="White"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Play/Start Icon -->
        <DataTemplate x:Key="PlayIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M8 5v14l11-7z" 
                          Fill="#4EC9B0"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Settings/Gear Icon -->
        <DataTemplate x:Key="SettingsIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" 
                          Fill="White"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Upload/Cloud Upload Icon -->
        <DataTemplate x:Key="UploadIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z" 
                          Fill="White"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Download Icon -->
        <DataTemplate x:Key="DownloadIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z" 
                          Fill="White"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Info Icon -->
        <DataTemplate x:Key="InfoIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                          Fill="#569CD6"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Warning Icon -->
        <DataTemplate x:Key="WarningIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" 
                          Fill="#FFC107"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Error/Cancel Icon -->
        <DataTemplate x:Key="ErrorIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z" 
                          Fill="#F44336"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Success Icon -->
        <DataTemplate x:Key="SuccessIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" 
                          Fill="#4CAF50"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Filter Icon -->
        <DataTemplate x:Key="FilterIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z" 
                          Fill="White"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Add/Plus Icon -->
        <DataTemplate x:Key="AddIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" 
                          Fill="#4EC9B0"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Delete/Trash Icon -->
        <DataTemplate x:Key="DeleteIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" 
                          Fill="#F44336"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Folder Icon -->
        <DataTemplate x:Key="FolderIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" 
                          Fill="#FFA726"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

    </syncfusion:ChromelessWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <!--<TextBlock Text="📄" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>-->
                        <TextBlock Name="txtProcedureName" Text="Stored Procedure Definition" 
                                  FontSize="18" FontWeight="SemiBold" 
                                  Foreground="#F1F1F1" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Name="txtProcedureInfo" Text="" 
                              FontSize="11" Foreground="#999999" Margin="30,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#3E3E42" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Name="txtLineCount" Text="0 lines" 
                                 FontSize="10" Foreground="#F1F1F1"/>
                    </Border>
                    <Border Background="#3E3E42" CornerRadius="4" Padding="8,4">
                        <TextBlock Name="txtCharCount" Text="0 chars" 
                                 FontSize="10" Foreground="#F1F1F1"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SQL Editor -->
        <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1,0,1,1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox Name="txtDefinition" 
                       IsReadOnly="True"
                       Background="Transparent"
                       Foreground="White"
                       FontFamily="Consolas"
                       FontSize="14"
                       FontWeight="Bold"
                       AcceptsReturn="True"
                       TextWrapping="NoWrap"
                       BorderThickness="0"
                       Padding="15"
                       SelectionBrush="#264F78"
                       VerticalScrollBarVisibility="Disabled"
                       HorizontalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
        </Border>

        <!-- Footer with Actions -->
        <Border Grid.Row="2" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="0,1,0,0" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <syncfusion:ButtonAdv Name="btnCopy" 
                                         Label="Copy" 
                                         IconTemplate="{StaticResource CopyIcon}"
                                         SizeMode="Normal" 
                                         Click="Copy_Click" 
                                         Width="120" 
                                         Height="32"
                                         Margin="0,0,10,0"/>
                    <syncfusion:ButtonAdv Name="btnExport" 
                                         Label="Export to File" 
                                         IconTemplate="{StaticResource ExportIcon}"
                                         SizeMode="Normal" 
                                         Click="Export_Click" 
                                         Width="140" 
                                         Height="32"/>
                </StackPanel>

                <syncfusion:ButtonAdv Grid.Column="1" 
                                     Name="btnClose" 
                                     Label="Close" 
                                     SizeMode="Normal" 
                                     Click="Close_Click" 
                                     IconTemplate="{StaticResource CheckIcon}"
                                     Width="100" 
                                     Height="32"/>
            </Grid>
        </Border>
    </Grid>
</syncfusion:ChromelessWindow>
