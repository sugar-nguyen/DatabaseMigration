<syncfusion:ChromelessWindow x:Class="DatabaseMigrationTool.QuickMigrateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:syncfusionshared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
        xmlns:syncfusiontools="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.WPF"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=VisualStudio2015}"
        Title="Quick Migrate - Stored Procedure" 
        Height="800" 
        Width="1200"
        WindowStartupLocation="CenterOwner"
        MinHeight="600"
        MinWidth="900"
        Icon="app-icon.png">
    <syncfusion:ChromelessWindow.Resources>
        <!-- Icon Templates -->
        <DataTemplate x:Key="PlayIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M8 5v14l11-7z" Fill="#4EC9B0"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="DatabaseIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M12 1C6.48 1 2 2.79 2 5v14c0 2.21 4.48 4 10 4s10-1.79 10-4V5c0-2.21-4.48-4-10-4zm0 2c4.42 0 8 1.34 8 3s-3.58 3-8 3-8-1.34-8-3 3.58-3 8-3zM4 9.5c1.72 1.05 4.56 1.5 8 1.5s6.28-.45 8-1.5V12c0 1.66-3.58 3-8 3s-8-1.34-8-3V9.5zm0 5c1.72 1.05 4.56 1.5 8 1.5s6.28-.45 8-1.5V17c0 1.66-3.58 3-8 3s-8-1.34-8-3v-2.5z" Fill="#4EC9B0"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="TestConnectionIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M12 2C6.48 2 2 6.48 2 12c0 5.52 4.48 10 10 10s10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" Fill="#4EC9B0"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="ClearIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M19.36 2.72l1.42 1.42-5.72 5.71c1.07 1.54 1.22 3.39.32 5.05-.21.39-.56.68-.97.82l-4.09-4.09-5.66 5.66-1.42-1.42 5.66-5.66L4.81 6.12c.14-.41.43-.76.82-.97 1.66-.91 3.51-.76 5.05.32l5.71-5.72M5.56 11.17L3.5 9.11 5.05 7.56l2.06 2.06-1.55 1.55z" Fill="White"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="CheckIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Fill="#4EC9B0"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>
    </syncfusion:ChromelessWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="15,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="Quick Migrate - Stored Procedure" FontSize="16" FontWeight="SemiBold" Foreground="#F1F1F1"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#3E3E42" CornerRadius="4" Padding="8,4">
                        <TextBlock Name="txtScriptStatus" Text="Ready" FontSize="10" Foreground="#4EC9B0" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Script Editor -->
            <GroupBox Grid.Column="0" Header="📝 Stored Procedure Script" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Script Info -->
                    <Border Grid.Row="0" Background="#3E3E42" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="💡 Paste your CREATE or ALTER PROCEDURE script here" 
                                     FontSize="11" Foreground="#F1F1F1" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Border Background="#2D2D30" CornerRadius="3" Padding="6,3" Margin="0,0,8,0">
                                    <TextBlock Name="txtLineCount" Text="0 lines" FontSize="9" Foreground="#999"/>
                                </Border>
                                <Border Background="#2D2D30" CornerRadius="3" Padding="6,3">
                                    <TextBlock Name="txtCharCount" Text="0 chars" FontSize="9" Foreground="#999"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Script Editor -->
                    <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Name="txtScriptEditor" 
                                   Background="#1E1E1E"
                                   Foreground="White"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   AcceptsReturn="True"
                                   TextWrapping="NoWrap"
                                   BorderThickness="0"
                                   Padding="10"
                                   TextChanged="ScriptEditor_TextChanged"
                                   VerticalScrollBarVisibility="Disabled"
                                   HorizontalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <syncfusion:ButtonAdv Name="btnValidate"
                                             Label="Validate Script"
                                             IconTemplate="{StaticResource CheckIcon}"
                                             SizeMode="Normal"
                                             Click="ValidateScript_Click"
                                             Width="130"
                                             Height="32"
                                             Margin="0,0,10,0"/>
                        <syncfusion:ButtonAdv Name="btnClearScript"
                                             Label="Clear"
                                             IconTemplate="{StaticResource ClearIcon}"
                                             SizeMode="Normal"
                                             Click="ClearScript_Click"
                                             Width="100"
                                             Height="32"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#3E3E42"/>

            <!-- Right Panel - Connection & Execution -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Connection Panel -->
                    <GroupBox Grid.Row="0" Header="🔗 Connection" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <Label Content="Server Name" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                            <ComboBox Name="cmbServer" IsEditable="True" Height="30" Margin="0,0,0,10" 
                                      SelectionChanged="Server_SelectionChanged"/>

                            <CheckBox Name="chkWindowsAuth" Content="Windows Authentication" IsChecked="True" 
                                    FontSize="11" Margin="0,0,0,10"/>

                            <StackPanel Name="pnlSqlAuth" Visibility="Collapsed">
                                <Label Content="Username" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                <TextBox Name="txtUsername" Height="30" Margin="0,0,0,10"/>
                                <Label Content="Password" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                <PasswordBox Name="txtPassword" Height="30" Margin="0,0,0,10"/>
                            </StackPanel>

                            <syncfusion:ButtonAdv Name="btnTestConnection"
                                                 Label="Test Connection"
                                                 IconTemplate="{StaticResource TestConnectionIcon}"
                                                 SizeMode="Normal"
                                                 Click="TestConnection_Click"
                                                 HorizontalAlignment="Stretch"
                                                 Height="32"
                                                 Margin="0,0,0,10"/>

                            <syncfusion:ButtonAdv Name="btnLoadDatabases"
                                                 Label="Load Databases"
                                                 IconTemplate="{StaticResource DatabaseIcon}"
                                                 SizeMode="Normal"
                                                 Click="LoadDatabases_Click"
                                                 HorizontalAlignment="Stretch"
                                                 Height="32"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Database Selection -->
                    <GroupBox Grid.Row="1" Header="📂 Target Databases" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Select Databases" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Grid.Column="1" Name="txtSelectedDbCount" Text="0 selected" 
                                         FontSize="10" Foreground="#999" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBox Name="txtDatabaseSearch" Height="25" Margin="0,0,0,8"
                                    TextChanged="DatabaseSearch_TextChanged"
                                    FontSize="11"/>

                            <ListBox Name="lstDatabases" Height="150" Margin="0,0,0,8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                    Checked="DatabaseCheckBox_Changed" 
                                                    Unchecked="DatabaseCheckBox_Changed" 
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ContentControl ContentTemplate="{StaticResource DatabaseIcon}" 
                                                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Orientation="Horizontal">
                                <CheckBox Name="chkSelectAllDatabases" Content="Select All" 
                                        Checked="SelectAllDatabases_Checked" 
                                        Unchecked="SelectAllDatabases_Unchecked" 
                                        FontSize="11" Margin="0,0,10,0"/>
                                <syncfusion:ButtonAdv Label="Clear" 
                                                     IconTemplate="{StaticResource ClearIcon}"
                                                     SizeMode="Small" 
                                                     Click="ClearAllDatabases_Click" 
                                                     Width="80" 
                                                     Height="24"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Execution Panel -->
                    <GroupBox Grid.Row="2" Header="⚡ Execute" Padding="10">
                        <StackPanel>
                            <syncfusion:ButtonAdv Name="btnExecute"
                                                 Label="Execute Script"
                                                 IconTemplate="{StaticResource PlayIcon}"
                                                 SizeMode="Normal"
                                                 Click="ExecuteScript_Click"
                                                 HorizontalAlignment="Stretch"
                                                 Height="40"
                                                 Margin="0,0,0,15"
                                                 IsEnabled="False"/>

                            <!-- Execution Log -->
                            <Label Content="Execution Log" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                            <Border Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Height="250">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox Name="txtExecutionLog"
                                           IsReadOnly="True"
                                           Background="Transparent"
                                           Foreground="#CCCCCC"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           AcceptsReturn="True"
                                           TextWrapping="Wrap"
                                           BorderThickness="0"
                                           Padding="8"
                                           VerticalScrollBarVisibility="Disabled"
                                           HorizontalScrollBarVisibility="Disabled"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="0,1,0,0" Padding="15,10">
            <Grid>
                <TextBlock Text="⚠️ Only CREATE PROCEDURE and ALTER PROCEDURE scripts are allowed" 
                         FontSize="10" Foreground="#FFC107" VerticalAlignment="Center"/>

                <syncfusion:ButtonAdv Name="btnClose"
                                     Label="Close"
                                     SizeMode="Normal"
                                     Click="Close_Click"
                                     IconTemplate="{StaticResource CheckIcon}"
                                     HorizontalAlignment="Right"
                                     Width="100"
                                     Height="28"/>
            </Grid>
        </Border>
    </Grid>
</syncfusion:ChromelessWindow>
