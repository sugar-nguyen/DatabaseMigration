<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationIcon>app-icon.ico</ApplicationIcon>
    <AssemblyTitle>Database Migration Tool</AssemblyTitle>
    <AssemblyName>DatabaseMigrationTool_v2.2.0</AssemblyName>
    <AssemblyDescription>A tool for migrating stored procedures between SQL Server databases</AssemblyDescription>
    <AssemblyCompany>Database Migration Solutions</AssemblyCompany>
    <AssemblyProduct>Database Migration Tool</AssemblyProduct>
    <Copyright>Copyright © 2025</Copyright>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Syncfusion.Licensing" Version="31.2.15" />
    <PackageReference Include="Syncfusion.Shared.WPF" Version="31.2.15" />
    <PackageReference Include="Syncfusion.Tools.WPF" Version="31.2.15" />
    <PackageReference Include="Syncfusion.SfSkinManager.WPF" Version="31.2.15" />
    <PackageReference Include="Syncfusion.Themes.VisualStudio2015.WPF" Version="31.2.15" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app-icon.png" />
    <Content Include="app-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Themes\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="key.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
