    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar with Status -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="app-icon.png" Width="24" Height="24" Margin="0,0,10,0"/>
                    <TextBlock Text="Database Migration Tool" FontSize="16" FontWeight="SemiBold" Foreground="#F1F1F1" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0.4" FontSize="11" Foreground="#999999" Margin="10,0,0,0" VerticalAlignment="Center" Name="txtSubVersion"/>
                </StackPanel>

                <!-- Menu Bar -->
                <Menu Grid.Column="1" Background="Transparent" Margin="20,0,0,0" VerticalAlignment="Center">
                    <MenuItem Header="⚡ Quick Migrate" Foreground="Black" FontSize="12" FontWeight="SemiBold" Click="QuickMigrate_Click">
                        <MenuItem.ToolTip>
                            <ToolTip Content="Quick migrate stored procedures by pasting script directly"/>
                        </MenuItem.ToolTip>
                    </MenuItem>
                </Menu>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#007ACC" CornerRadius="12" Padding="10,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#4EC9B0" Margin="0,0,6,0"/>
                            <TextBlock Name="lblStatus" Text="Ready" FontSize="12" Foreground="White" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with DockingManager -->
        <syncfusion:DockingManager Grid.Row="1" x:Name="dockingManager" UseDocumentContainer="True" PersistState="True">

            <!-- Connection Panel (Left) -->
            <ContentControl syncfusion:DockingManager.Header="Connection Setup" 
                          syncfusion:DockingManager.State="Dock"
                          syncfusion:DockingManager.SideInDockedMode="Left"
                          syncfusion:DockingManager.DesiredWidthInDockedMode="380">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Server Connection -->
                        <GroupBox Header="🌐 Server Connection" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <Label Content="Server Name" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox Name="cmbServer" IsEditable="True" SelectionChanged="Server_SelectionChanged" Height="30"/>

                                <CheckBox Name="chkWindowsAuth" Content="Use Windows Authentication" IsChecked="True" 
                                        Checked="WindowsAuth_Changed" Unchecked="WindowsAuth_Changed" Margin="0,10,0,0"/>

                                <StackPanel Name="sqlAuthPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Label Content="Username" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox Name="txtUsername" Height="30"/>
                                    <Label Content="Password" FontWeight="SemiBold" Margin="0,10,0,5"/>
                                    <PasswordBox Name="txtPassword" Height="30"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                    <syncfusion:ButtonAdv Name="btnTestConnection" 
                                                         IconTemplate="{StaticResource TestConnectionIcon}" 
                                                         Label="Test Connection" 
                                                         SizeMode="Normal" 
                                                         Click="TestConnection_Click" 
                                                         Margin="0,0,10,0" 
                                                         Width="140" 
                                                         Height="32"/>
                                    <syncfusion:ButtonAdv Name="btnRefreshDatabases" 
                                                         Label="Load Databases"  
                                                         IconTemplate="{StaticResource ConnectDbIcon}"
                                                         SizeMode="Normal" 
                                                         Click="RefreshDatabases_Click" 
                                                         Width="140" 
                                                         Height="32"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Source Database -->
                        <GroupBox Header="📂 Source Database" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <Label Content="Select Database" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox Name="cmbSourceDatabase" SelectionChanged="SourceDatabase_SelectionChanged" Height="30"/>

                                <syncfusion:ButtonAdv Name="btnLoadProcedures" 
                                                     Label="Load Objects" 
                                                     IconTemplate="{StaticResource LoadObjectIcon}"
                                                     SizeMode="Normal" 
                                                     Click="LoadStoredProcedures_Click" 
                                                     HorizontalAlignment="Stretch" 
                                                     Margin="0,15,0,0" 
                                                     Height="32"/>

                                <!-- Summary Info -->
                                <Border Background="#3E3E42" CornerRadius="4" Padding="12" Margin="0,15,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Stored Procedures:" FontSize="11" Foreground="#F1F1F1"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Name="lblTotalProcedures" Text="0" 
                                                 FontSize="14" FontWeight="Bold" Foreground="#4EC9B0" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tables:" FontSize="11" Foreground="#F1F1F1" Margin="0,5,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Name="lblTotalTables" Text="0" 
                                                 FontSize="14" FontWeight="Bold" Foreground="#569CD6" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- Target Configuration -->
                        <GroupBox Header="⚙️ Target Configuration" Padding="10">
                            <StackPanel Name="stkTargetConfiguration">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Name="lblTargetMode" Text="📍 Same Server" FontWeight="SemiBold" 
                                             FontSize="12" Foreground="#007ACC" VerticalAlignment="Center"/>
                                    <syncfusion:ButtonAdv Name="btnDifferentServer" 
                                                         IconTemplate="{StaticResource ServerIcon}"
                                                         Label="Different Server" 
                                                         SizeMode="Small" 
                                                         Click="DifferentServer_Click" 
                                                         Margin="10,0,0,0" 
                                                         Width="140" 
                                                         Height="28"/>
                                    <syncfusion:ButtonAdv Name="btnSameServer" 
                                                         IconTemplate="{StaticResource ServerIcon}"
                                                         Label="Same Server" 
                                                         SizeMode="Small" 
                                                         Click="SameServer_Click" 
                                                         Margin="10,0,0,0" 
                                                         Width="120" 
                                                         Height="28" 
                                                         Visibility="Collapsed"/>
                                </StackPanel>

                                <StackPanel Name="stkCurrentTarget">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Name="lblCurrentServer" Content="Target Databases" FontWeight="SemiBold"/>
                                        <syncfusion:ButtonAdv Grid.Column="1" 
                                                             Name="btnFullscreenTargetDatabases" 
                                                             IconTemplate="{StaticResource FullscreenIcon}"
                                                             Label="" 
                                                             ToolTip="Fullscreen selector" 
                                                             Click="FullscreenTargetDatabases_Click" 
                                                             Width="32" 
                                                             Height="32" 
                                                             SizeMode="Small"/>
                                    </Grid>

                                    <TextBox Name="txtTargetDatabaseSearch" Height="30" 
                                           TextChanged="TargetDatabaseSearch_TextChanged"/>

                                    <ListBox Name="lstTargetDatabases" Height="120" Margin="0,8,0,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                            Checked="TargetDatabaseCheckBox_Changed" 
                                                            Unchecked="TargetDatabaseCheckBox_Changed" 
                                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ContentControl ContentTemplate="{StaticResource DatabaseIcon}" 
VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Name="txtSelectedDatabasesCount" Text="0 database(s) selected" 
                                             FontSize="10" Foreground="#808080" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </ContentControl>

            <!-- Database Objects Panel (Center Document) -->
            <ContentControl syncfusion:DockingManager.Header="Database Objects" 
                          syncfusion:DockingManager.State="Document">
                <Grid>
                    <syncfusion:TabControlExt Name="tabDatabaseObjects" 
                                             SelectionChanged="TabDatabaseObjects_SelectionChanged">

                        <!-- Stored Procedures Tab -->
                        <syncfusion:TabItemExt Header="📋 Stored Procedures">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Search Box -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox  Name="txtSearchProcedures" Height="30" 
                                           KeyDown="SearchTextBox_KeyDown"/>
                                    <syncfusion:ButtonAdv Name="btnSearchProcedures" 
                                                         Grid.Column="1" 
                                                         Label="Search" 
                                                         IconTemplate="{StaticResource SearchIcon}"
                                                         Click="SearchProcedures_Click" 
                                                         Width="100" 
                                                         Height="30" 
                                                         Margin="8,0,0,0"/>
                                </Grid>

                                <!-- Selection Controls -->
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Name="chkSelectAll" Content="Select All" 
                                                Checked="SelectAll_Checked" Unchecked="SelectAll_Unchecked" 
                                                FontWeight="SemiBold"/>
                                        <syncfusion:ButtonAdv Label="Clear All" 
                                                             IconTemplate="{StaticResource ClearIcon}"
                                                             Click="ClearAll_Click" 
                                                             SizeMode="Small" 
                                                             Margin="10,0,0,0" 
                                                             Width="100" 
                                                             Height="28"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Name="txtProcedureCount" Text="0 procedures" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Name="txtSelectedProceduresCount" Text="0 selected" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Procedures List -->
                                <ListBox Grid.Row="2" Name="lstStoredProcedures" 
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        MouseRightButtonUp="ListStoredProcedures_MouseRightButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <CheckBox IsChecked="{Binding IsSelected}" Tag="{Binding}" 
                                                        Checked="ProcedureCheckBox_Changed" Unchecked="ProcedureCheckBox_Changed" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ContentControl ContentTemplate="{StaticResource StoredProcedureIcon}" 
                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding FullName}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </syncfusion:TabItemExt>

                        <!-- Tables Tab -->
                        <syncfusion:TabItemExt Header="🗂️ Tables">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Search Box -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="txtSearchTables" Height="30" 
                                           KeyDown="SearchTextBox_KeyDown"/>
                                    <syncfusion:ButtonAdv Name="btnSearchTables" 
                                                         Grid.Column="1" 
                                                         Label="Search" 
                                                         IconTemplate="{StaticResource SearchIcon}"
                                                         Click="SearchTables_Click" 
                                                         Width="100" 
                                                         Height="30" 
                                                         Margin="8,0,0,0"/>
                                </Grid>

                                <!-- Selection Controls -->
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" >
                                        <CheckBox Name="chkSelectAllTables"  Content="Select All" 
                                                Checked="SelectAllTables_Checked"  Unchecked="SelectAllTables_Unchecked" 
                                                FontWeight="SemiBold"/>
                                        <syncfusion:ButtonAdv Label="Clear All" 
                                                             IconTemplate="{StaticResource ClearIcon}"
                                                             Click="ClearAllTables_Click" 
                                                             SizeMode="Small" 
                                                             Margin="10,0,0,0" 
                                                             Width="100" 
                                                             Height="28"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Name="txtTableCount" Text="0 tables" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Name="txtSelectedTablesCount" Text="0 selected" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Tables List -->
                                <ListBox Grid.Row="2" Name="lstTables" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <CheckBox IsChecked="{Binding IsSelected}" Tag="{Binding}" 
                                                        Checked="TableCheckBox_Changed" Unchecked="TableCheckBox_Changed" 
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ContentControl ContentTemplate="{StaticResource TableIcon}" 
               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding FullName}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </syncfusion:TabItemExt>
                    </syncfusion:TabControlExt>
                </Grid>
            </ContentControl>

            <!-- Migration Control Panel (Right) -->
            <ContentControl syncfusion:DockingManager.Header="Migration Control" 
                          syncfusion:DockingManager.State="Dock"
                          syncfusion:DockingManager.SideInDockedMode="Right"
                          syncfusion:DockingManager.DesiredWidthInDockedMode="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Action Buttons -->
                        <GroupBox Header="🚀 Actions" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <syncfusion:ButtonAdv Name="btnGenerateTargetSettings" 
                                                     Label="Generate Settings" 
                                                     IconTemplate="{StaticResource SettingsIcon}"
                                                     Click="GenerateTargetSettings_Click" 
                                                     HorizontalAlignment="Stretch" 
                                                     Height="38" 
                                                     Margin="0,0,0,8"/>
                                <syncfusion:ButtonAdv Name="btnPreviewScripts" 
                                                     Label="Preview Scripts" 
                                                     IconTemplate="{StaticResource PreviewIcon}"
                                                     Click="PreviewScripts_Click" 
                                                     HorizontalAlignment="Stretch" 
                                                     Height="38" 
                                                     Margin="0,0,0,8"/>
                                <syncfusion:ButtonAdv Name="btnStartMigration" 
                                                     Label="Start Migration" 
                                                     IconTemplate="{StaticResource MigrationIcon}"
                                                     Click="StartMigration_Click" 
                                                     HorizontalAlignment="Stretch" 
                                                     Height="38" 
                                                     Margin="0,0,0,8"/>
                                <syncfusion:ButtonAdv Name="btnRollback" 
                                                     Label="Rollback Migration" 
                                                     IconTemplate="{StaticResource RollbackIcon}"
                                                     Click="Rollback_Click" 
                                                     HorizontalAlignment="Stretch" 
                                                     Height="38" 
                                                     IsEnabled="False"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Migration Options -->
                        <GroupBox Header="⚙️ Options" Margin="0,0,0,15" Padding="10">
                            <CheckBox Name="chkCreateBackup" Content="Create backup before migration" 
                                    IsChecked="True" FontSize="11"/>
                        </GroupBox>

                        <!-- Status Panel -->
                        <GroupBox Header="📊 Status" Margin="0,0,0,15" Padding="10">
                            <Border Padding="10" Background="#3E3E42" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" FontSize="11" Foreground="#F1F1F1"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Ready" FontSize="11" FontWeight="Bold" Foreground="#4EC9B0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Objects:" FontSize="11" Foreground="#F1F1F1" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="0/0" FontSize="11" FontWeight="Bold" Margin="0,5,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Progress:" FontSize="11" Foreground="#F1F1F1" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="0%" FontSize="11" FontWeight="Bold" Margin="0,5,0,0"/>
                                </Grid>
                            </Border>
                        </GroupBox>

                        <!-- Rollback History -->
                        <GroupBox Header="📜 Rollback History" Padding="10">
                            <StackPanel>
                                <!-- Header with Clear button -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" 
                                             Name="txtRollbackHistoryCount"
                                             Text="0 record(s)" 
                                             FontSize="11" 
                                             FontWeight="SemiBold"
                                             Foreground="#999999"
                                             VerticalAlignment="Center"/>
                                    
                                    <syncfusion:ButtonAdv Grid.Column="1"
                                                         Name="btnClearHistory"
                                                         Label="Clear History"
                                                         IconTemplate="{StaticResource DeleteAllIcon}"
                                                         SizeMode="Small"
                                                         Click="ClearHistory_Click"
                                                         Width="120"
                                                         Height="28"
                                                         ToolTip="Clear all rollback history"/>
                                </Grid>

                                <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Name="lstRollbackHistory">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#3E3E42" BorderBrush="#555555" BorderThickness="1" 
                                                      CornerRadius="3" Margin="0,0,0,5" Padding="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding MigrationTimestamp, StringFormat='Migration: {0:yyyy-MM-dd HH:mm:ss}'}" 
                                                                     FontSize="10" FontWeight="SemiBold" Foreground="#F1F1F1"/>
                                                            <TextBlock Text="{Binding TargetDatabasesCount, StringFormat={}{0} target databases}" 
                                                                     FontSize="9" Foreground="#999999" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding BackupCount, StringFormat={}{0} procedures backed up}" 
                                                                     FontSize="9" Foreground="#999999"/>
                                                            <TextBlock FontSize="9" FontWeight="SemiBold" Margin="0,2,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CanRollback}" Value="True">
                                                                                <Setter Property="Text" Value="✓ Available"/>
                                                                                <Setter Property="Foreground" Value="#4EC9B0"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding CanRollback}" Value="False">
                                                                                <Setter Property="Text" Value="✗ Rolled back"/>
                                                                                <Setter Property="Foreground" Value="#808080"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <syncfusion:ButtonAdv Grid.Column="1" 
                                                                             Label="" 
                                                                             IconTemplate="{StaticResource RollbackIcon}"
                                                                             SizeMode="Small" 
                                                                             Width="32" 
                                                                             Height="32" 
                                                                             Click="RollbackItem_Click" 
                                                                             Tag="{Binding}" 
                                                                             IsEnabled="{Binding CanRollback}"
                                                                             ToolTip="Rollback this migration"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </ContentControl>

            <!-- Migration Log Panel (Bottom Document) -->
            <ContentControl syncfusion:DockingManager.Header="📊 Migration Log" 
                          syncfusion:DockingManager.State="Dock"
                          syncfusion:DockingManager.SideInDockedMode="Bottom"
                          syncfusion:DockingManager.DesiredHeightInDockedMode="200">
                <Grid>
                    <Border Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1">
                        <ScrollViewer Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" 
                                    HorizontalScrollBarVisibility="Auto" Background="Transparent">
                            <TextBox Name="txtMigrationLog" 
                                   IsReadOnly="True" 
                                   Background="Transparent"
                                   Foreground="#CCCCCC"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   AcceptsReturn="True"
                                   TextWrapping="Wrap"
                                   BorderThickness="0"
                                   Padding="10"
                                   SelectionBrush="#264F78"
                                   MinHeight="150"
                                   VerticalScrollBarVisibility="Disabled"
                                   HorizontalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </ContentControl>
        </syncfusion:DockingManager>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#007ACC" Height="24" BorderBrush="#3E3E42" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Database Migration Tool v1.0.4" Name="tblVersion"
                         FontSize="10" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>

                <TextBlock Grid.Column="2" Text="© 2025 Database Migration Solutions" 
                         FontSize="9" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <syncfusion:DocumentContainer x:Name="docContainer" Mode="MDI"
                                      BorderThickness="1" Visibility="Hidden"/>
    </Grid>
</syncfusion:ChromelessWindow>
