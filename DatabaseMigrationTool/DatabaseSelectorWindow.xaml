<syncfusion:ChromelessWindow x:Class="DatabaseMigrationTool.DatabaseSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=VisualStudio2015}"
        Title="Database Selector" 
        Height="600" Width="500" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MinHeight="400" MinWidth="400"
        Icon="app-icon.png">
    
    <syncfusion:ChromelessWindow.Resources>
        <!-- Icon Templates -->

        <!-- Database Icon -->
        <DataTemplate x:Key="DatabaseIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M12 1C6.48 1 2 2.79 2 5v14c0 2.21 4.48 4 10 4s10-1.79 10-4V5c0-2.21-4.48-4-10-4zm0 2c4.42 0 8 1.34 8 3s-3.58 3-8 3-8-1.34-8-3 3.58-3 8-3zM4 9.5c1.72 1.05 4.56 1.5 8 1.5s6.28-.45 8-1.5V12c0 1.66-3.58 3-8 3s-8-1.34-8-3V9.5zm0 5c1.72 1.05 4.56 1.5 8 1.5s6.28-.45 8-1.5V17c0 1.66-3.58 3-8 3s-8-1.34-8-3v-2.5z" 
                        Fill="#4EC9B0"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Search Icon -->
        <DataTemplate x:Key="SearchIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                        Fill="White"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Clear Icon -->
        <DataTemplate x:Key="ClearIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M19.36 2.72l1.42 1.42-5.72 5.71c1.07 1.54 1.22 3.39.32 5.05-.21.39-.56.68-.97.82l-4.09-4.09-5.66 5.66-1.42-1.42 5.66-5.66L4.81 6.12c.14-.41.43-.76.82-.97 1.66-.91 3.51-.76 5.05.32l5.71-5.72M5.56 11.17L3.5 9.11 5.05 7.56l2.06 2.06-1.55 1.55z" 
                        Fill="White"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Check Icon -->
        <DataTemplate x:Key="CheckIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" 
                        Fill="#4EC9B0"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Folder Icon -->
        <DataTemplate x:Key="FolderIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" 
                        Fill="#FFA726"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

    </syncfusion:ChromelessWindow.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="20,15">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ContentControl ContentTemplate="{StaticResource FolderIcon}" 
                                  Width="24" Height="24" 
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                    <TextBlock Text="Select Target Databases" 
                              FontSize="18" FontWeight="SemiBold" 
                              Foreground="#F1F1F1"
                              VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Search and select databases for migration" 
                          FontSize="11" 
                          Foreground="#999999"
                          HorizontalAlignment="Center" 
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Box -->
            <GroupBox Grid.Row="0" Header="🔍 Search" Padding="10" Margin="0,0,0,15">
                <Grid>
                    <TextBox Name="txtSearch" 
                            Height="30"
                            FontSize="12"
                            Padding="8"
                            VerticalContentAlignment="Center"
                            TextChanged="SearchTextBox_TextChanged"/>
                    
                    <!-- Placeholder text -->
                    <TextBlock Text="Type to search databases..." 
                              FontSize="11"
                              Foreground="#808080"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              Margin="10,0,0,0"
                              IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </GroupBox>

            <!-- Selection Controls -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <CheckBox Name="chkSelectAll" 
                             Content="Select All Visible" 
                             Checked="SelectAll_Checked" 
                             Unchecked="SelectAll_Unchecked"
                             FontSize="12" FontWeight="SemiBold"/>
                    <syncfusion:ButtonAdv Name="btnClearAll" 
                                         Label="Clear All"
                                         IconTemplate="{StaticResource ClearIcon}"
                                         Click="ClearAll_Click"
                                         SizeMode="Small"
                                         Margin="10,0,0,0"
                                         Width="100" Height="28"/>
                </StackPanel>
                
                <Border Grid.Column="1" Background="#3E3E42" CornerRadius="12" Padding="8,4">
                    <TextBlock Name="txtSelectionCount" 
                              Text="0 selected" 
                              FontSize="11" 
                              FontWeight="SemiBold"
                              Foreground="#4EC9B0"
                              VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Database List -->
            <Border Grid.Row="2" BorderBrush="#555555" BorderThickness="1" 
                    Background="#2D2D30">
                <ListBox Name="lstDatabases" 
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="5"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Checked="DatabaseCheckBox_Changed"
                                         Unchecked="DatabaseCheckBox_Changed"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" 
                                          FontSize="11"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Bottom Controls -->
        <Border Grid.Row="2" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="0,1,0,0" Padding="20,15">
            <syncfusion:ButtonAdv Grid.Row="3" 
                                 Name="btnClose" 
                                 Label="Done" 
                                 IconTemplate="{StaticResource CheckIcon}"
                                 Click="Cancel_Click" 
                                 SizeMode="Normal"
                                 HorizontalAlignment="Center"
                                 Width="120" Height="36"/>
        </Border>
    </Grid>
</syncfusion:ChromelessWindow>
